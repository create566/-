# ================================================
# 智能监控平台 - 环境变量配置
# ================================================
# 复制为 .env 后修改实际值

# ===================
# 应用配置
# ===================
APP_NAME=SmartMonitor
APP_VERSION=1.1.0
DEBUG=False
HOST=0.0.0.0
PORT=9900

# ===================
# LLM 配置
# ===================
# 提供商选项：vllm / ollama / openai
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Ollama 特定配置（LLM_PROVIDER=ollama 时使用）
OLLAMA_MODEL=qwen2.5:7b

# ===================
# Embedding 配置
# ===================
# 提供商选项：local / openai / azure
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024
# 云端备选（EMBEDDING_PROVIDER=openai 或 azure 时使用）
EMBEDDING_CLOUD_MODEL=text-embedding-3-small
EMBEDDING_CLOUD_DIM=1536

# ===================
# 数据库配置
# ===================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=smart_monitor

# ===================
# Redis 配置
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================
# Milvus 配置
# ===================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ===================
# 飞书告警通知
# ===================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
FEISHU_ENABLED=True
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# ===================
# API 认证
# ===================
API_KEY=change-this-in-production

# ===================
# Prometheus（远程检测器用）
# ===================
PROMETHEUS_URL=http://localhost:9090

# ===================
# 报告保存目录
# ===================
REPORT_DIR=./reports

# ================================================
# 配置示例
# ================================================

# --- 云端 LLM + 云端 Embedding ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_CLOUD_MODEL=text-embedding-3-small

# --- 本地 Ollama LLM + 本地 Embedding ---
# LLM_PROVIDER=ollama
# LLM_API_KEY=local
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# EMBEDDING_PROVIDER=local
# EMBEDDING_API_KEY=local
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-large-zh-v1.5
# EMBEDDING_DIM=1024

# --- vLLM LLM ---
# LLM_PROVIDER=vllm
# LLM_API_KEY=local
# LLM_API_BASE=http://localhost:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct