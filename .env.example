# 应用配置
APP_NAME=SmartMonitor
APP_VERSION=1.1.0
DEBUG=False
HOST=0.0.0.0
PORT=9900

# ===================
# LLM 配置
# ===================
# 提供商：vllm / ollama / openai
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ===================
# Embedding 配置
# ===================
# 提供商：local（本地 Ollama）/ openai / azure
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=local
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024
# 云端备选（EMBEDDING_PROVIDER=openai 时使用）
EMBEDDING_CLOUD_MODEL=text-embedding-3-small
EMBEDDING_CLOUD_DIM=1536

# ===================
# 数据库配置
# ===================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=smart_monitor

# ===================
# Redis 配置
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================
# Milvus 配置
# ===================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ===================
# 飞书告警通知
# ===================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
FEISHU_ENABLED=True
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# ===================
# API 认证
# ===================
API_KEY=change-this-in-production

# ===================
# Prometheus（远程检测器用）
# ===================
PROMETHEUS_URL=http://localhost:9090

# ===================
# 报告保存目录
# ===================
REPORT_DIR=./reports