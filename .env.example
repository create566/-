# ============================================================
# 智能监控平台 — 环境配置
# 复制为 .env:  cp .env.example .env
# 只需填 LLM 和数据库，其他保持默认
# ============================================================

# ===================
# 应用配置
# ===================
APP_NAME=SmartMonitor
APP_VERSION=1.2.0
DEBUG=False
HOST=0.0.0.0
PORT=9900

# ===================
# LLM 配置（四选一）
# ===================
# 选项 1: vLLM（本地高性能推理）
# LLM_PROVIDER=vllm
# LLM_API_KEY=empty
# LLM_API_BASE=http://localhost:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct

# 选项 2: Ollama（本地推理）
# LLM_PROVIDER=ollama
# LLM_API_KEY=empty
# LLM_API_BASE=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 选项 3: DashScope（阿里云灵积）
# LLM_PROVIDER=dashscope
# LLM_API_KEY=sk-your-dashscope-key
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# 选项 4: DeepSeek（默认激活）
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Embedding ──
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_API_BASE=https://api.deepseek.com
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=smart_monitor

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ── 飞书告警通知（可选）──
FEISHU_ENABLED=False
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── API 认证 ──
API_KEY=change-this-in-production

# ── Prometheus（远程检测器用）──
PROMETHEUS_URL=http://localhost:9090

# ── 报告保存目录 ──
REPORT_DIR=./reports
